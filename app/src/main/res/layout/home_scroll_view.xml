<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F0F0F">

    <ImageView
        android:id="@+id/home_scroll_preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        tools:src="@drawable/example_poster" />

    <View
        android:id="@+id/title_shadow_top"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_gravity="top"
        android:alpha="0.4"
        android:background="@drawable/yt_card_scrim"
        android:rotation="180"
        android:visibility="visible" />

    <View
        android:id="@+id/title_shadow"
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:layout_gravity="bottom"
        android:background="@drawable/yt_card_scrim" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="start|bottom"
        android:layout_marginBottom="56dp"
        android:orientation="vertical"
        android:paddingHorizontal="14dp">

        <ImageView
            android:id="@+id/home_preview_logo"
            android:layout_width="160dp"
            android:layout_height="44dp"
            android:layout_gravity="start"
            android:contentDescription="@null"
            android:paddingBottom="4dp"
            android:scaleType="fitStart" />

        <TextView
            android:id="@+id/home_scroll_preview_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="start"
            android:maxLines="1"
            android:paddingBottom="2dp"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold"
            tools:text="The Perfect Run" />

        <TextView
            android:id="@+id/home_scroll_preview_tags"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="start"
            android:maxLines="1"
            android:textColor="#AAAAAA"
            android:textSize="12sp"
            tools:text="Action • Drama • 2026" />
    </LinearLayout>

</FrameLayout>