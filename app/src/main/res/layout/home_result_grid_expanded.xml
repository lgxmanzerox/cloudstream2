<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginEnd="12dp"
    android:layout_marginBottom="6dp"
    android:backgroundTint="@color/transparent"
    android:foreground="@drawable/outline_drawable"
    app:cardBackgroundColor="@color/transparent"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp">

    <!-- Needed for layout tests -->
    <ImageView
        android:id="@+id/title_shadow"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        tools:ignore="ContentDescription" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <androidx.cardview.widget.CardView
            android:id="@+id/background_card"
            android:layout_width="256dp"
            android:layout_height="144dp"
            android:elevation="4dp"
            app:cardBackgroundColor="#1F1F1F"
            app:cardCornerRadius="12dp">

            <ImageView
                android:id="@+id/imageView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/search_poster_img_des"
                android:duplicateParentState="true"
                android:foreground="?android:attr/selectableItemBackgroundBorderless"
                android:scaleType="centerCrop"
                tools:src="@drawable/example_poster" />

            <FrameLayout
                android:id="@+id/watch_progress_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/search_item_download_play"
                    style="@style/HomePlayUnderlayProgress" />

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/watchProgress"
                    style="@style/HomeCircularProgress"
                    app:indicatorColor="#FF0000"
                    tools:progress="50" />
            </FrameLayout>

            <TextView
                android:id="@+id/text_quality"
                style="@style/TypeButton"
                android:layout_margin="6dp"
                android:background="@drawable/yt_badge_bg"
                android:textColor="#FFFFFF" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_margin="6dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/text_is_dub"
                    style="@style/DubButton"
                    android:layout_gravity="end" />

                <TextView
                    android:id="@+id/text_is_sub"
                    style="@style/SubButton"
                    android:layout_gravity="end" />

                <TextView
                    android:id="@+id/text_rating"
                    style="@style/RatingButton"
                    android:layout_gravity="end"
                    tools:text="7.7" />

                <TextView
                    android:id="@+id/text_flag"
                    style="@style/SearchBox"
                    android:layout_gravity="end"
                    android:background="@color/transparent"
                    android:textSize="16sp"
                    android:visibility="gone"
                    tools:text="🇸🇪"
                    tools:visibility="visible" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:gravity="end"
                android:orientation="vertical"
                android:padding="6dp">

                <TextView
                    android:id="@+id/episode_text"
                    style="@style/EpisodeTextButton"
                    android:layout_width="wrap_content"
                    android:layout_gravity="end"
                    android:background="@drawable/yt_badge_bg"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- YouTube-style left-aligned 2-line video title below thumbnail -->
        <TextView
            android:id="@+id/imageText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="start"
            android:ellipsize="end"
            android:gravity="start"
            android:lineSpacingExtra="2dp"
            android:maxLines="2"
            android:minLines="2"
            android:paddingHorizontal="4dp"
            android:paddingTop="8dp"
            android:paddingBottom="4dp"
            android:textColor="#F1F1F1"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="The Perfect Run — Episode 1" />
    </LinearLayout>
</androidx.cardview.widget.CardView>
